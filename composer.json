{
  "name": "clarity/elearning",
  "description": "Clarity E-Learning — Website E-Learning Kampus (PHP 8.2+ Native REST API & Vanilla JS Frontend)",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "firebase/php-jwt": "^7.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "scripts": {
    "migrate": "php bin/migrate.php",
    "seed": "php bin/seed.php",
    "setup": [
      "@migrate",
      "@seed"
    ]
  },
  "config": {
    "sort-packages": true
  }
}
